{
  "name": "r-workbench",
  "version": "0.3.3",
  "description": "R Workbench - AI驱动的R语言数据分析工作台，替代SPSS的开源方案",
  "main": "./out/main/index.js",
  "keywords": [
    "r-language",
    "statistics",
    "data-analysis",
    "spss-alternative",
    "electron",
    "academic",
    "thesis",
    "survey-analysis",
    "i18n",
    "internationalization",
    "bilingual"
  ],
  "author": "R Workbench Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azazhsCN/r-workbench.git"
  },
  "homepage": "https://github.com/azazhsCN/r-workbench#readme",
  "scripts": {
    "dev": "electron-vite dev --config config/electron.vite.config.ts",
    "build": "npm run typecheck:node && npm run typecheck:web && electron-vite build --config config/electron.vite.config.ts",
    "build:only": "electron-vite build --config config/electron.vite.config.ts",
    "preview": "electron-vite preview --config config/electron.vite.config.ts",
    "start": "electron-vite preview --config config/electron.vite.config.ts",
    "check:officecli": "node scripts/validate/check-officecli.cjs",
    "build:unpack": "npm run check:officecli && npm run build && electron-builder --dir",
    "build:win": "npm run check:officecli && npm run build && electron-builder --win",
    "build:mac": "npm run check:officecli && npm run build && electron-builder --mac",
    "build:linux": "npm run check:officecli && npm run build && electron-builder --linux",
    "typecheck:node": "tsc --noEmit -p config/tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p config/tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint src/ --config config/eslint.config.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "format": "prettier --config config/.prettierrc --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --config config/.prettierrc --check \"src/**/*.{ts,tsx,json,css}\"",
    "verify:sav": "node scripts/validate/verify.cjs",
    "verify:ipc": "node scripts/validate/verify_ipc.cjs",
    "verify:lazy": "node scripts/validate/lazy_r_check.cjs",
    "verify:negcache": "node scripts/validate/negcache_r_check.cjs",
    "verify:packaged": "node scripts/validate/packaged_app_check.cjs",
    "validate:stat": "Rscript scripts/validate/run_validation.R",
    "validate:oracle-failure": "Rscript scripts/validate/prove_failure_ability.R"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13",
    "sav-reader": "^2.0.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.39.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.8.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "build": {
    "extends": "./electron-builder.json5"
  }
}
