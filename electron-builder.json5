{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "com.rworkbench.app",
  "productName": "R Workbench",
  "copyright": "Copyright © 2026 R Workbench Team",
  "directories": {
    "buildResources": "resources",
    "output": "releases"
  },
  "files": [
    "!**/.vscode/*",
    "!src/*",
    "!electron.vite.config.*",
    "!{.eslintignore,.eslintrc.*,.prettierignore,.prettierrc.*,tsconfig.json,tsconfig.*.json,eslint.config.*}",
    "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
    "!**/node_modules/.cache/**"
  ],
  "extraResources": [
    {
      "from": "src/main/rScripts",
      "to": "rScripts"
    },
    {
      // ⚠ 必须与 src/main/ipc.ts 中 detectOfficeCli() 的首选候选保持一致：
      //   join(process.resourcesPath, 'bin', 'officecli.exe')
      // v0.2.5 曾写成 "officecli.exe"（落到 resources/officecli.exe），而检测代码找的是
      // resources/bin/officecli.exe → 打包后 Word 导出 100% 失效（仅 dev 模式可用）。
      // 注意 resources/bin/ 在 .gitignore 中：新克隆缺少该二进制时 electron-builder 只会
      // 告警（fileMatcher.js:273）不会失败，因此构建入口已加显式存在性检查：
      //   package.json → "build:win": "npm run check:officecli && ..."
      //   scripts/validate/check-officecli.cjs
      "from": "resources/bin/officecli.exe",
      "to": "bin/officecli.exe"
    },
    {
      // 窗口图标：src/main/index.ts 的 resolveWindowIcon() 会读
      // join(process.resourcesPath, 'icon.png')。旧代码引用 asar 内的
      // resources/icon.png（asar 里没有该目录）→ 打包后是死引用。
      "from": "resources/icon.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icon.ico"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "resources/icon.png",
    "category": "public.app-category.education"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "resources/icon.png",
    "category": "Education"
  },
  "asar": true
}
